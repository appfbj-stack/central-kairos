// Central Kairos — Prisma Schema
// Banco: PostgreSQL (kairos-shared-pg do Dokploy)
// Cria o banco `central_kairos_db` na primeira migração.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum InstallationStatus {
  TRIAL
  ACTIVE
  BLOCKED
  EXPIRED
  ARCHIVED
}

// Planos comerciais (Sprint v0.2.0+)
// FREE: 15 msgs/mês (trial)
// BASIC: 100 msgs/mês
// PRO: 200 msgs/mês
// ULTRA: 300 msgs/mês
// ENTERPRISE: ilimitado
enum Plan {
  FREE
  BASIC
  PRO
  ULTRA
  ENTERPRISE
}

// Tipo de reset do contador de mensagens (Sprint v0.5.0+)
// DAILY: reseta todo dia (free trial) — usado no Kairós PWA / Igreja
// MONTHLY: reseta a cada 30 dias
enum PeriodType {
  DAILY
  MONTHLY
}

// Categoria do lembrete (Sprint v0.6.0+)
enum ReminderType {
  MEETING   // reunião, compromisso
  BIRTHDAY  // aniversário
  TASK      // tarefa, afazer
  OTHER
}

// Categoria comum de gasto (Sprint v0.6.0+)
enum ExpenseCategory {
  FOOD          // comida, mercado, restaurante
  CLOTHING      // roupa, calçado
  TRANSPORT     // uber, gasolina, passagem
  HEALTH        // farmácia, médico
  HOUSING       // aluguel, conta
  ENTERTAINMENT // lazer, streaming
  OTHER
}

// ============================================================
// ADMIN USER (você — único super admin da Central)
// ============================================================

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  sessions AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// INSTALLATION (cada app vendido/instalado)
// ============================================================

model Installation {
  id           String             @id // "APP-0001" (gerado via max(id)+1)
  productName  String // "Kairos Igreja"
  clientName   String // "Igreja OBPC"
  companyName  String? // "OBPC Sede"
  appUrl       String // "https://igrejak.fbautomacao.space"
  dbIdentifier String? // referência ao banco dela (ex: "kairos_igreja_db_v2")
  status       InstallationStatus @default(TRIAL)
  trialStartAt DateTime?
  trialEndsAt  DateTime?
  registeredAt DateTime           @default(now())
  notes        String?

  // Licenciamento (Sprint v0.2.0+)
  plan             Plan      @default(FREE) // plano atual do cliente
  usageLimit       Int       @default(15) // limite de mensagens no período
  usageUsed        Int       @default(0) // mensagens já consumidas no período
  // Token control (Sprint v0.4.0+) — limita custo real por mês
  tokensLimit      Int       @default(50000) // limite de tokens no período (50k default FREE)
  tokensUsed       Int       @default(0) // tokens já consumidos no período
  currentPeriodEnd DateTime? // quando reseta (mensal)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history InstallationStatusHistory[]

  @@index([status])
  @@index([productName])
  @@index([plan])
}

// ============================================================
// STATUS HISTORY (audit log de mudanças de status)
// ============================================================

model InstallationStatusHistory {
  id             String              @id @default(cuid())
  installationId String
  fromStatus     InstallationStatus?
  toStatus       InstallationStatus
  reason         String?
  changedBy      String // admin user id (texto, não FK rígida)

  createdAt DateTime @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId])
}

// ============================================================
// PWA — Etapa 3a (Multi-cliente PWA + Agente Local + WebSocket)
// Sprint 1.20 — 2026-10-13
// Adiciona: Client (cliente PWA), Device (PWA + Electron), Task
// (fila de jobs), Conversation + Message (historico), OtpCode
// (2FA), ClientSession (revogavel), DeviceHeartbeat (status online)
// ============================================================

enum ClientStatus {
  TRIAL
  ACTIVE
  BLOCKED
  EXPIRED
}

enum DeviceKind {
  PWA
  ELECTRON
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum TaskStatus {
  PENDING
  SENT
  RUNNING
  DONE
  ERROR
  CANCELLED
}

model Client {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  name             String
  status           ClientStatus @default(TRIAL)
  trialStartAt     DateTime?
  trialEndsAt      DateTime?
  tokensLimit      Int          @default(50000)
  tokensUsed       Int          @default(0)
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Plano de assinatura (Sprint v0.5.0+) — exibe no header do chat PWA
  plan          Plan       @default(FREE) // FREE/BASIC/PRO/ULTRA/ENTERPRISE
  usageLimit    Int        @default(10) // limite de mensagens no período (FREE=10/dia)
  usageUsed     Int        @default(0) // mensagens já consumidas no período
  periodType    PeriodType @default(DAILY) // DAILY (free) ou MONTHLY (pagos)
  outputTokenCap Int       @default(500) // max tokens na resposta da LLM
  lastUsageReset DateTime? // ultimo reset de usageUsed (pra DAILY)

  devices       Device[]
  conversations Conversation[]
  sessions      ClientSession[]
  otpCodes      OtpCode[]
  tasks         Task[]
  reminders     Reminder[]
  expenses      Expense[]

  @@index([status])
  @@index([email])
  @@index([plan])
}

// ============================================================
// LEMBRETE (Sprint v0.6.0+)
// Cliente agenda compromissos, tarefas, aniversarios. Mostrados no chat
// quando chega a data (ou no "/agenda" do dia).
// ============================================================

model Reminder {
  id        String       @id @default(cuid())
  clientId  String
  when      DateTime     // quando deve lembrar
  message   String       // texto do lembrete
  type      ReminderType @default(MEETING)
  sent      Boolean      @default(false) // ja foi exibido/enviado?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, when])
  @@index([sent, when])
}

// ============================================================
// GASTO (Sprint v0.6.0+)
// Cliente fala "comprei cafe 30" e Kairós soma pra resposta "quanto gastei".
// ============================================================

model Expense {
  id          String          @id @default(cuid())
  clientId    String
  amount      Float           // em reais (BRL)
  description String          // ex: "cafe", "camisa polo"
  category    ExpenseCategory @default(OTHER)
  occurredAt  DateTime        @default(now()) // quando aconteceu a compra
  createdAt   DateTime        @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
  @@index([clientId, category])
}

model ClientSession {
  id        String   @id @default(cuid())
  clientId  String
  jwtId     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model Device {
  id          String       @id @default(cuid())
  clientId    String
  kind        DeviceKind
  name        String?
  deviceToken String       @unique
  os          String?
  hardware    String?
  status      DeviceStatus @default(PENDING)
  lastSeenAt  DateTime?
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([clientId])
  @@index([status])
  @@index([deviceToken])
}

model OtpCode {
  id        String    @id @default(cuid())
  clientId  String
  codeHash  String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model Conversation {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([clientId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  attachments    Json?    // [{ name, mime, size, dataUrl }] - imagens inline (multimodal)
  toolCalls      Json?
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  status         String   @default("done")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Task {
  id          String     @id @default(cuid())
  clientId    String
  deviceId    String?
  convId      String?
  kind        String
  params      Json
  result      Json?
  errorMsg    String?
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([deviceId, status])
}

model DeviceHeartbeat {
  id       BigInt   @id @default(autoincrement())
  deviceId String
  ts       DateTime @default(now())
  online   Boolean
  meta     Json?

  @@index([deviceId, ts])
}
